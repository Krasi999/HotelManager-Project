<UserControl x:Class="HotelManager.WPF.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#FEF9E7" CornerRadius="8"
                            Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblFormTitle"
                                   Text="Нова резервация"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#1A252F"/>
                        <TextBlock x:Name="lblFormSubtitle"
                                   Text="Попълни данните за резервацията"
                                   FontSize="11" Foreground="#483D8B"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="#F0F4F8" Margin="0,0,0,16"/>

                <TextBlock x:Name="lblRoom" Text="Стая"
                           Foreground="Blue"
                           Style="{StaticResource SubTitle}"/>
                <ComboBox ItemsSource="{Binding AvailableRooms}"
                          SelectedItem="{Binding SelectedRoom}"
                          DisplayMemberPath="Number"
                          Margin="0,0,0,12"/>

                <TextBlock x:Name="lblGuest" Text="Гост"
                           Foreground="Blue"
                           Style="{StaticResource SubTitle}"/>
                <ComboBox ItemsSource="{Binding Guests}"
                          SelectedItem="{Binding SelectedGuest}"
                          DisplayMemberPath="FullName"
                          Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblCheckIn"
                                   Text="Настаняване"
                                   Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                        <DatePicker SelectedDate="{Binding CheckIn}"
                                    FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblCheckOut"
                                   Text="Напускане"
                                   Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                        <DatePicker SelectedDate="{Binding CheckOut}"
                                    FontSize="13"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="lblStatus" Text="Статус"
                           Foreground="Blue"
                           Style="{StaticResource SubTitle}"/>
                    <ComboBox SelectedValue="{Binding Status}"
                            SelectedValuePath="Tag"
                            Margin="0,0,0,16">
                        <ComboBoxItem x:Name="cmbConfirmed" 
                                      Content="Потвърдена"  Tag="Confirmed"/>
                        <ComboBoxItem x:Name="cmbCancelled" 
                                      Content="Отменена"    Tag="Cancelled"/>
                        <ComboBoxItem x:Name="cmbCompleted" 
                                      Content="Завършена"   Tag="Completed"/>
                    </ComboBox>


                <Border Background="#F0FFF4" CornerRadius="8"
                        Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblTotalLabel"
                                   Grid.Column="0"
                                   Text="Обща цена:"
                                   FontSize="13"
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalPrice,
                                       StringFormat={}{0:F2} евро}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </Grid>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button x:Name="btnAdd"
                            Content="➕  Добави"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnUpdate"
                            Content="✏️  Обнови"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateCommand}"
                            Margin="6,0,0,0"/>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button x:Name="btnDelete"
                            Content="🗑️  Изтрий"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnClear"
                            Content="🔄  Нов запис"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ClearCommand}"
                            Margin="6,0,0,0"/>
                </UniformGrid>

                    <Border x:Name="StatusBorder"
        Background="#EAF6FF"
        CornerRadius="8"
        Padding="12,10"
        Margin="0,16,0,8"
        Visibility="{Binding StatusMessage,
            Converter={StaticResource
                StringToVisibilityConverter}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,4">
                                <TextBlock x:Name="StatusIcon"
                       Text="ℹ️"
                       FontSize="13"
                       Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusIconLabel"
                       Text="Информация"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#1A6FA8"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText"
                   Text="{Binding StatusMessage}"
                   Foreground="#1A6FA8"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="18"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        
        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblGridTitle"
                                   Text="Списък на резервации"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#1A252F"/>
                        <TextBlock x:Name="lblGridSubtitle"
                                   Text="Избери ред за редактиране"
                                   FontSize="11" Foreground="#483D8B"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="btnLoad"
                            Content="🔄  Зареди"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadCommand}"/>
                </Grid>

                <Border Grid.Row="1" Height="1"
                        Background="#F0F4F8" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2"
          ItemsSource="{Binding LocalizedReservations}"
          SelectedItem="{Binding SelectedLocalizedReservation,
              Mode=TwoWay}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#33006994"
          BorderThickness="0"
          Background="Transparent"
          RowBackground="Transparent"
          FontSize="13"
          RowHeight="36"
          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="colRoom"
            Header="Стая"
            Binding="{Binding RoomNumber}"
            Width="70"/>
                        <DataGridTextColumn x:Name="colGuest"
            Header="Гост"
            Binding="{Binding GuestName}"
            Width="150"/>
                        <DataGridTextColumn x:Name="colCheckIn"
            Header="Настаняване"
            Binding="{Binding CheckIn}"
            Width="110"/>
                        <DataGridTextColumn x:Name="colCheckOut"
            Header="Напускане"
            Binding="{Binding CheckOut}"
            Width="110"/>
                        <DataGridTextColumn x:Name="colNights"
            Header="Нощувки"
            Binding="{Binding Nights}"
            Width="70"/>
                        <DataGridTextColumn x:Name="colPrice"
            Header="Цена"
            Binding="{Binding TotalPrice}"
            Width="120"/>
                        <DataGridTextColumn x:Name="colStatus"
            Header="Статус"
            Binding="{Binding Status}"
            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>