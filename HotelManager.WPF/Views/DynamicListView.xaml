<UserControl x:Class="HotelManager.WPF.Views.DynamicListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblPageTitle"
                               Text="Динамичен списък"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1A252F"/>
                    <TextBlock x:Name="lblPageSubtitle"
                               Text="Избери какво да покажеш"
                               FontSize="11" Foreground="#483D8B"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnRoomsBasic"
                            Content="🛏  Стаи — основни"
                            Style="{StaticResource PrimaryButton}"
                            Click="RoomsBasic_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnRoomsAll"
                            Content="🛏  Стаи — всички"
                            Style="{StaticResource PrimaryButton}"
                            Click="RoomsAll_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnReservations"
                            Content="📋  Резервации"
                            Style="{StaticResource PrimaryButton}"
                            Click="Reservations_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnClear"
                            Content="🗑️  Изчисти"
                            Style="{StaticResource DangerButton}"
                            Click="Clear_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="lblGridTitle"
                           Text="Резултати"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#1A252F"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1"
                           x:Name="lblStatus"
                           FontSize="12" Foreground="#95A5A6"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="2" Height="1"
                        Background="#F0F4F8" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="3"
                          x:Name="DynamicGrid"
                          SelectionChanged="DynamicGrid_SelectionChanged"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}"
                Margin="0,16,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblSelectedLabel"
                           Text="Избран обект:"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#1A252F"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="SelectedObjectText"
                           FontSize="13" Foreground="#2980B9"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>