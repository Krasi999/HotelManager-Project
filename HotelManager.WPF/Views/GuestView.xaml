<UserControl x:Class="HotelManager.WPF.Views.GuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
   
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#E8F8F5" CornerRadius="8"
                            Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="👤" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblFormTitle"
                                   Text="Детайли за гост"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#1A252F"/>
                            <TextBlock x:Name="lblFormSubtitle"
                                   Text="Добави или редактирай гост"
                                   FontSize="11" Foreground="#483D8B"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#F0F4F8" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblFirstName" Text="Име"
                                       Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                            <TextBox Text="{Binding FirstName,
                                       UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblLastName" Text="Фамилия"
                                       Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                            <TextBox Text="{Binding LastName,
                                       UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="lblEmail" Text="Имейл"
                               Foreground="Blue"
                           Style="{StaticResource SubTitle}"/>
                    <TextBox Text="{Binding Email,
                               UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblPhone" Text="Телефон"
                                       Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                            <TextBox Text="{Binding Phone,
                                       UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblEGN" Text="ЕГН"
                                       Foreground="Blue"
                                   Style="{StaticResource SubTitle}"/>
                            <TextBox Text="{Binding EGN,
                                       UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="lblBirth" Text="Дата на раждане"
                               Foreground="Blue"
                           Style="{StaticResource SubTitle}"/>
                    <DatePicker SelectedDate="{Binding DateOfBirth}"
                            Margin="0,0,0,20" FontSize="13"/>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="btnAdd"
                            Content="➕  Добави"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"
                            Margin="0,0,6,0"/>
                        <Button x:Name="btnUpdate"
                            Content="✏️  Обнови"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateCommand}"
                            Margin="6,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button x:Name="btnDelete"
                            Content="🗑️  Изтрий"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"
                            Margin="0,0,6,0"/>
                        <Button x:Name="btnClear"
                            Content="🔄  Нов запис"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ClearCommand}"
                            Margin="6,0,0,0"/>
                    </UniformGrid>


                    <Border x:Name="StatusBorder"
        Background="#EAF6FF"
        CornerRadius="8"
        Padding="12,10"
        Margin="0,16,0,8"
        Visibility="{Binding StatusMessage,
            Converter={StaticResource
                StringToVisibilityConverter}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,4">
                                <TextBlock x:Name="StatusIcon"
                       Text="ℹ️"
                       FontSize="13"
                       Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusIconLabel"
                       Text="Информация"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#1A6FA8"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText"
                   Text="{Binding StatusMessage}"
                   Foreground="#1A6FA8"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="18"/>
                        </StackPanel>
                    </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

        
        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblGridTitle"
                                   Text="Списък на гости"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#1A252F"/>
                        <TextBlock x:Name="lblGridSubtitle"
                                   Text="Избери ред за редактиране"
                                   FontSize="11" Foreground="#483D8B"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="btnLoad"
                            Content="🔄  Зареди"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadCommand}"/>
                </Grid>

                <Border Grid.Row="1" Height="1"
                        Background="#F0F4F8" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2"
          ItemsSource="{Binding LocalizedGuests}"
          SelectedItem="{Binding SelectedLocalizedGuest,
              Mode=TwoWay}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#33006994"
          BorderThickness="0"
          Background="Transparent"
          RowBackground="Transparent"
          FontSize="13"
          RowHeight="36"
          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="colFirstName"
            Header="Име"
            Binding="{Binding FirstName}"
            Width="100"/>
                        <DataGridTextColumn x:Name="colLastName"
            Header="Фамилия"
            Binding="{Binding LastName}"
            Width="100"/>
                        <DataGridTextColumn x:Name="colEmail"
            Header="Имейл"
            Binding="{Binding Email}"
            Width="180"/>
                        <DataGridTextColumn x:Name="colPhone"
            Header="Телефон"
            Binding="{Binding Phone}"
            Width="110"/>
                        <DataGridTextColumn x:Name="colEGN"
            Header="ЕГН"
            Binding="{Binding EGN}"
            Width="100"/>
                        <DataGridTextColumn x:Name="colBirth"
            Header="Дата на раждане"
            Binding="{Binding DateOfBirth}"
            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>