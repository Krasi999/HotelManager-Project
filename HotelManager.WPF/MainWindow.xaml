<Window x:Class="HotelManager.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Manager" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush ImageSource="/Assets/hotel_background_photo.jpg"
                    Stretch="UniformToFill"
                    Opacity="1"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#33FFFFFF"/>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">
                    <GradientStop Color="#CC006994" Offset="0"/>
                    <GradientStop Color="#CC009BB5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🏨" FontSize="26"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Hotel Manager"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnLang"
                            Content="🌐 EN"
                            Click="BtnLang_Click"
                            Background="#33FFFFFF"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="#66FFFFFF"
                            Padding="12,5"
                            FontSize="12"
                            Cursor="Hand"
                            Margin="0,0,16,0"/>
                    <TextBlock x:Name="DbIndicator"
                               Foreground="#CCF0F8FF"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="MainTabControl"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#E8FFFFFF"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#22006994">
                            <TabPanel IsItemsHost="True"
                                      Background="Transparent"/>
                        </Border>

                        <ContentPresenter Grid.Row="1"
                            ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding"         Value="22,14"/>
                    <Setter Property="FontSize"        Value="13"/>
                    <Setter Property="Foreground"      Value="#555555"/>
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        x:Name="Content"
                                        ContentSource="Header"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="BorderBrush"
                                                Value="#006994"/>
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#15006994"/>
                                        <Setter Property="Foreground"
                                                Value="#006994"/>
                                        <Setter Property="FontWeight"
                                                Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#0D006994"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem x:Name="TabRooms"
                     Header="🛏  Стаи">
                <ContentControl x:Name="RoomsContent"/>
            </TabItem>

            <TabItem x:Name="TabGuests"
                     Header="👤  Гости">
                <ContentControl x:Name="GuestsContent"/>
            </TabItem>

            <TabItem x:Name="TabReservations"
                     Header="📋  Резервации">
                <ContentControl x:Name="ReservationsContent"/>
            </TabItem>

            <TabItem x:Name="TabFilter"
                     Header="🔍  Филтри">
                <ContentControl x:Name="FilterContent"/>
            </TabItem>

            <TabItem x:Name="TabDynList"
                     Header="📊  Динамичен списък">
                <ContentControl x:Name="DynListContent"/>
            </TabItem>

        </TabControl>

        <Border Grid.Row="0" Grid.RowSpan="2"
                x:Name="LoadingOverlay"
                Visibility="Collapsed"
                Panel.ZIndex="999">
            <Border.Background>
                <SolidColorBrush Color="Black" Opacity="0.55"/>
            </Border.Background>

            <Border Background="White"
                    CornerRadius="16"
                    Padding="48,36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40"
                                      Opacity="0.25"
                                      ShadowDepth="10"
                                      Color="#004E6E"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="🌐"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="LoadingText"
                               Text="Превеждане..."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#006994"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="LoadingSubText"
                               Text="LibreTranslate работи..."
                               FontSize="12"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ProgressBar x:Name="LoadingProgress"
                                 IsIndeterminate="True"
                                 Width="240"
                                 Height="6"
                                 Margin="0,0,0,12">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="#006994"
                                              Offset="0"/>
                                <GradientStop Color="#009BB5"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                        <ProgressBar.Background>
                            <SolidColorBrush Color="#E0F0F8"/>
                        </ProgressBar.Background>
                    </ProgressBar>

                    <TextBlock x:Name="LoadingStep"
                               Text=""
                               FontSize="11"
                               Foreground="#BDC3C7"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>